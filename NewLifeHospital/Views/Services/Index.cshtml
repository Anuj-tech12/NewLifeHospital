@{
ViewData["Title"] = "Our Services";
}

<!-- SERVICES HERO -->

<section class="services-hero">
    <div class="services-hero-content">
        <span class="services-tag">OUR HEALTHCARE SERVICES</span>


    <h1>
        Complete Care for<br />
        <span>A Healthier Life.</span>
    </h1>

    <p>
        Discover healthcare services designed around your needs,
        with a focus on patient comfort, safety and well-being.
    </p>

    <a asp-controller="Home"
       asp-action="Contact"
       class="services-hero-btn">
        Contact Our Team <span>→</span>
    </a>
</div>


</section>

<!-- SERVICES LIST -->

<section class="services-section">

<div class="services-heading">
    <span>WHAT WE OFFER</span>
    <h2>Our Medical Services</h2>
    <p>
        Explore our range of healthcare services for you and your family.
    </p>
</div>

<div class="services-grid">

    <!-- SERVICE 1 -->
    <article class="service-card">
        <div class="service-icon">🩺</div>

        <span class="service-number">01</span>

        <h3>General Medicine</h3>

        <p>
            Medical consultation, routine health assessments
            and support for common health concerns.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="service-link">
            Learn More <span>→</span>
        </a>
    </article>

    <!-- SERVICE 2 -->
    <article class="service-card">
        <div class="service-icon">👶</div>

        <span class="service-number">02</span>

        <h3>Pediatrics</h3>

        <p>
            Healthcare support for infants, children
            and adolescents, including growth monitoring.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="service-link">
            Learn More <span>→</span>
        </a>
    </article>

    <!-- SERVICE 3 -->
    <article class="service-card">
        <div class="service-icon">❤️</div>

        <span class="service-number">03</span>

        <h3>Cardiology</h3>

        <p>
            Heart-health consultation, cardiovascular
            assessments and specialist referral support.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="service-link">
            Learn More <span>→</span>
        </a>
    </article>

    <!-- SERVICE 4 -->
    <article class="service-card">
        <div class="service-icon">🦴</div>

        <span class="service-number">04</span>

        <h3>Orthopedics</h3>

        <p>
            Assessment and care for bone, joint and
            muscle concerns.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="service-link">
            Learn More <span>→</span>
        </a>
    </article>

    <!-- SERVICE 5 -->
    <article class="service-card">
        <div class="service-icon">🧪</div>

        <span class="service-number">05</span>

        <h3>Laboratory Services</h3>

        <p>
            Diagnostic testing services to support
            medical evaluation and treatment decisions.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="service-link">
            Learn More <span>→</span>
        </a>
    </article>

    <!-- SERVICE 6 -->
    <article class="service-card">
        <div class="service-icon">🚑</div>

        <span class="service-number">06</span>

        <h3>Emergency Care</h3>

        <p>
            Emergency assessment and appropriate
            medical assistance when urgent care is needed.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="service-link">
            Learn More <span>→</span>
        </a>
    </article>

</div>


</section>

<!-- SERVICES CTA -->

<section class="services-cta">
    <div class="services-cta-content">
        <span>WE ARE HERE FOR YOU</span>


    <h2>Your Health Deserves the Best Care.</h2>

    <p>
        Have a question about our services?
        Contact our team to learn more.
    </p>

    <a asp-controller="Home"
       asp-action="Contact"
       class="services-cta-btn">
        Contact Us <span>→</span>
    </a>
</div>

</section>
