@{
    ViewData["Title"] = "Our Doctors";
}

<section class="doctors-hero">
    <div class="doctors-hero-content">
        <span class="doctors-tag">OUR MEDICAL TEAM</span>

        ```
        <h1>Meet Our <span>Expert Doctors</span></h1>

        <p>
            Experienced professionals dedicated to your health,
            comfort, and well-being.
        </p>

        <a asp-controller="Appointment"
           asp-action="Index"
           class="doctors-main-btn">
            Book an Appointment →
        </a>
    </div>
    ```

</section>

<section class="doctors-section">
    <div class="doctors-heading">
        <span>TRUSTED MEDICAL CARE</span>
        <h2>Meet Our Specialists</h2>
        <p>Quality healthcare starts with the right team.</p>
    </div>

    ```
    <div class="doctors-grid">

        <article class="doctor-card">
            <div class="doctor-image doctor-image-one">
                <div class="doctor-placeholder">👨‍⚕️</div>
            </div>

            <div class="doctor-info">
                <span class="doctor-specialty">PEDIATRICS</span>
                <h3>Dr. Doctor One</h3>
                <p>Child Health Specialist</p>

                <a asp-controller="Appointment"
                   asp-action="Index"
                   class="doctor-btn">
                    Book Appointment →
                </a>
            </div>
        </article>

        <article class="doctor-card">
            <div class="doctor-image doctor-image-two">
                <div class="doctor-placeholder">👩‍⚕️</div>
            </div>

            <div class="doctor-info">
                <span class="doctor-specialty">GENERAL MEDICINE</span>
                <h3>Dr. Doctor Two</h3>
                <p>General Physician</p>

                <a asp-controller="Appointment"
                   asp-action="Index"
                   class="doctor-btn">
                    Book Appointment →
                </a>
            </div>
        </article>

        <article class="doctor-card">
            <div class="doctor-image doctor-image-three">
                <div class="doctor-placeholder">👨‍⚕️</div>
            </div>

            <div class="doctor-info">
                <span class="doctor-specialty">ORTHOPEDICS</span>
                <h3>Dr. Doctor Three</h3>
                <p>Orthopedic Specialist</p>

                <a asp-controller="Appointment"
                   asp-action="Index"
                   class="doctor-btn">
                    Book Appointment →
                </a>
            </div>
        </article>

    </div>
    ```

</section>
