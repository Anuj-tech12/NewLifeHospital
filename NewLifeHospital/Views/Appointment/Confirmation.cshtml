@{
    ViewData["Title"] = "Appointment Confirmation";
}

<div style="min-height:70vh; display:flex; align-items:center; justify-content:center; background:#f0f8ff; padding:30px;">

    
    <div style="max-width:650px; width:100%; background:white; padding:40px 25px; border-radius:18px; text-align:center; box-shadow:0 8px 30px rgba(0,0,0,0.1);">

        <div style="font-size:60px; color:#16a34a;">&#10004;</div>

        <h1 style="color:#087fbd; margin:20px 0;">
            Appointment Request Received!
        </h1>

        <p>Thank you, <strong>@ViewBag.PatientName</strong>.</p>

        <p>Your appointment request details are:</p>

        <div style="background:#f8fafc; padding:20px; border-radius:10px; text-align:left; margin:25px 0;">

            <p><strong>Patient Name:</strong> @ViewBag.PatientName</p>

            <p><strong>Doctor:</strong> @ViewBag.Doctor</p>

            <p><strong>Appointment Date:</strong> @ViewBag.AppointmentDate</p>

            <p><strong>Preferred Time:</strong> @ViewBag.AppointmentTime</p>

        </div>

        <p>
            Hospital staff will need to contact you to confirm the appointment.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           style="display:inline-block; margin-top:20px; padding:13px 25px; background:#087fbd; color:white; text-decoration:none; border-radius:8px;">
            Back to Home
        </a>

    </div>
    

</div>
