@{
ViewData["Title"] = "Contact Us";
}

<!-- CONTACT HERO -->

<section class="contact-hero">
    <div class="contact-hero-content">
        <span class="contact-tag">GET IN TOUCH</span>


    <h1>
        We're Here to<br />
        <span>Help You.</span>
    </h1>

    <p>
        Have a question about our healthcare services?
        Contact our team and we'll help you find the information you need.
    </p>
</div>


</section>

<!-- CONTACT INFORMATION -->

<section class="contact-section">


<div class="contact-heading">
    <span>CONTACT INFORMATION</span>
    <h2>Let's Start a Conversation</h2>
    <p>Reach out to our team using the information below.</p>
</div>

<div class="contact-layout">

    <!-- LEFT SIDE -->
    <div class="contact-info-panel">

        <h3>Contact Information</h3>

        <p class="contact-info-description">
            We're happy to help with general enquiries
            about our hospital and services.
        </p>

        <div class="contact-info-item">
            <div class="contact-info-icon">📍</div>

            <div>
                <h4>Hospital Address</h4>
                <p>Enter your hospital's complete address here.</p>
            </div>
        </div>

        <div class="contact-info-item">
            <div class="contact-info-icon">📞</div>

            <div>
                <h4>Phone Number</h4>
                <p>Enter your hospital's phone number here.</p>
            </div>
        </div>

        <div class="contact-info-item">
            <div class="contact-info-icon">✉️</div>

            <div>
                <h4>Email Address</h4>
                <p>Enter your hospital's email address here.</p>
            </div>
        </div>

        <div class="contact-info-item">
            <div class="contact-info-icon">🕒</div>

            <div>
                <h4>Working Hours</h4>
                <p>Please contact the hospital to confirm timings.</p>
            </div>
        </div>

    </div>

    <!-- RIGHT SIDE: CONTACT FORM -->
    <div class="contact-form-panel">

        <h3>Send Us a Message</h3>

        <p class="contact-form-description">
            Fill in the form below to share your enquiry.
        </p>

            @if (TempData["ContactSuccess"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["ContactSuccess"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    @Html.ValidationSummary(false)
                </div>
            }

        <form asp-controller="Home"
              asp-action="Contact"
              method="post">

            @Html.AntiForgeryToken()

            <div class="contact-form-row">

                <div class="contact-form-group">
                    <label for="contactName">Full Name</label>

                    <input type="text"
                           id="contactName"
                           name="Name"
                           placeholder="Enter your full name"
                           maxlength="100"
                           required />
                </div>

                <div class="contact-form-group">
                    <label for="contactEmail">Email Address</label>

                    <input type="email"
                           id="contactEmail"
                           name="Email"
                           placeholder="Enter your email"
                           maxlength="254"
                           required />
                </div>

            </div>

            <div class="contact-form-group">
                <label for="contactPhone">Phone Number</label>

                <input type="tel"
                       id="contactPhone"
                       name="Phone"
                       placeholder="Enter your phone number"
                       maxlength="20" />
            </div>

            <div class="contact-form-group">
                <label for="contactSubject">Subject</label>

                <input type="text"
                       id="contactSubject"
                       name="Subject"
                       placeholder="How can we help?"
                       maxlength="150"
                       required />
            </div>

            <div class="contact-form-group">
                <label for="contactMessage">Your Message</label>

                <textarea id="contactMessage"
                          name="Message"
                          rows="5"
                          maxlength="2000"
                          placeholder="Write your message here..."
                          required></textarea>
            </div>

            <button type="submit" class="contact-submit-btn">
                Send Message <span>→</span>
            </button>

            <p class="contact-form-note">
                Please do not include sensitive medical information
                in this general enquiry form.
            </p>

        </form>

    </div>

</div>


</section>

<!-- BOTTOM CONTACT BANNER -->

<section class="contact-bottom-banner">
    <div>
        <span>YOUR HEALTH MATTERS</span>


    <h2>We're Ready to Help.</h2>

    <p>
        Contact our hospital team for information about available services.
    </p>
</div>

<a asp-controller="Home"
   asp-action="Index"
   class="contact-home-btn">
    Back to Home →
</a>


</section>
