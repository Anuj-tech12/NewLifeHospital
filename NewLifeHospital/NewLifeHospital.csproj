		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>1330a73e-236d-4b4d-9810-b533fee9ccb6</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MailKit" Version="4.18.2" />
